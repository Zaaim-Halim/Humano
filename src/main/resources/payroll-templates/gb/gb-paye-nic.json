  "steps": [
    {
      "id": "notDirector",
      "type": "REQUIRE",
      "condition": "!#employee['director']",
      "message": "Directors' NICs use an annual earnings period, which this template does not support"
    },
    {
      "id": "noStudentLoan",
      "type": "REQUIRE",
      "condition": "#employee['studentLoan'] == 'NONE'",
      "message": "Student and postgraduate loan deductions are not supported by this template"
    },
    {
      "id": "noPreTaxDeductions",
      "type": "REQUIRE",
      "condition": "#preTaxDeductions == 0",
      "message": "Pre-tax deductions (net pay pension schemes, salary sacrifice) are not supported by this template"
    },
    {
      "id": "categoryAge",
      "type": "REQUIRE",
      "when": "#employee['niCategory'] == 'M' or #employee['niCategory'] == 'Z'",
      "condition": "#ageAtPeriodEnd < 21",
      "message": "NI categories M and Z are for employees under 21"
    },
    {
      "id": "categoryApprenticeAge",
      "type": "REQUIRE",
      "when": "#employee['niCategory'] == 'H'",
      "condition": "#ageAtPeriodEnd < 25",
      "message": "NI category H is for apprentices under 25"
    },
    {
      "id": "categoryPensionAge",
      "type": "REQUIRE",
      "when": "#employee['niCategory'] == 'C' or #employee['niCategory'] == 'S' or #employee['niCategory'] == 'K'",
      "condition": "#ageAtPeriodEnd >= 66",
      "message": "NI categories C, S and K are for employees over State Pension age, which nobody under 66 has reached in 2026/27"
    },
    {
      "id": "taxPeriod",
      "type": "VALUE",
      "expr": "#frequency == 'MONTHLY' ? #taxMonth : #taxWeek"
    },
    {
      "id": "intervalPeriods",
      "type": "VALUE",
      "expr": "#frequency == 'BIWEEKLY' ? 2 : 1"
    },
    {
      "id": "broughtForward",
      "type": "VALUE",
      "expr": "#employee['broughtForwardTaxYear'] != null and #employee['broughtForwardTaxYear'] == #taxYear"
    },
    {
      "id": "payePay",
      "type": "VALUE",
      "expr": "#taxableEarnings - #reductions"
    },
    {
      "id": "week53",
      "type": "VALUE",
      "source": "hmrc-cwg2-2026",
      "expr": "#frequency != 'MONTHLY' and #taxWeek > 52 ? 1 : 0"
    },
    {
      "id": "codeNonCumulative",
      "type": "VALUE",
      "expr": "#employee['taxCode'].replace(' ', '').toUpperCase().matches('.+(W1|M1|X)') ? 1 : 0"
    },
    {
      "id": "payeToDate",
      "type": "VALUE",
      "expr": "#ytd.base('incomeTax', 'TAX') + (#broughtForward ? #coalesce(#employee['broughtForwardPay'], 0) : 0)"
    },
    {
      "id": "paye",
      "type": "EXTENSION",
      "extension": "uk.paye-routines-v24",
      "source": "hmrc-paye-spec-v24",
      "inputs": {
        "taxCode": "#week53 == 1 and #codeNonCumulative == 0 ? #employee['taxCode'] + ' W1' : #employee['taxCode']",
        "period": "#taxPeriod",
        "periodsPerYear": "#frequency == 'MONTHLY' ? 12 : 52",
        "intervalPeriods": "#intervalPeriods",
        "pay": "#payePay",
        "payToDate": "#payeToDate",
        "taxToDate": "#ytd.amount('incomeTax', 'TAX') + (#broughtForward ? #coalesce(#employee['broughtForwardTax'], 0) : 0)",
        "rates": "{#p['rukRate1'], #p['rukRate2'], #p['rukRate3'], #p['rukRate4']}",
        "bands": "{#p['rukBand1'], #p['rukBand2'], #p['rukBand3']}",
        "basicRateIndex": "2",
        "scottishRates": "{#p['scotRate1'], #p['scotRate2'], #p['scotRate3'], #p['scotRate4'], #p['scotRate5'], #p['scotRate6']}",
        "scottishBands": "{#p['scotBand1'], #p['scotBand2'], #p['scotBand3'], #p['scotBand4'], #p['scotBand5']}",
        "scottishBasicRateIndex": "2",
        "welshRates": "{#p['welshRate1'], #p['welshRate2'], #p['welshRate3'], #p['welshRate4']}",
        "welshBands": "{#p['rukBand1'], #p['rukBand2'], #p['rukBand3']}",
        "welshBasicRateIndex": "2",
        "maxRate": "#p['maxRate']"
      }
    },
    {
      "id": "midYearStart",
      "type": "REQUIRE",
      "when": "(#paye['cumulative'] == 1 or (#week53 == 1 and #codeNonCumulative == 0)) and #taxPeriod > #intervalPeriods and #ytd.periods('incomeTax', 'TAX') == 0",
      "condition": "#broughtForward",
      "message": "No earlier payroll this tax year is recorded for this employee: set the pay and tax brought forward (P45 / previous payroll, 0 if none) and broughtForwardTaxYear before running a cumulative tax code"
    },
    {
      "id": "incomeTax",
      "type": "TAX",
      "label": "Income tax (PAYE)",
      "ledger": "INCOME_TAX",
      "source": "hmrc-paye-spec-v24",
      "base": "#payePay",
      "recordZero": true,
      "allowNegative": true,
      "amount": "#week53 == 1 and #codeNonCumulative == 0 and #paye['freePay'] > 0 and #paye['freePay'] * (#intervalPeriods == 2 ? 26 : 52) >= #payeToDate + #payePay ? 0 : #paye['tax']"
    },
    {
      "id": "niPay",
      "type": "VALUE",
      "expr": "#socialEarnings - #reductions"
    },
    {
      "id": "niBand2",
      "type": "VALUE",
      "expr": "#pos(#min(#niPay, #table.lookup('niLimits', #frequency, 'LEL')) - #table.lookup('niLimits', #frequency, 'ST'))"
    },
    {
      "id": "niBand3",
      "type": "VALUE",
      "expr": "#pos(#min(#niPay, #table.lookup('niLimits', #frequency, 'PT')) - #table.lookup('niLimits', #frequency, 'LEL'))"
    },
    {
      "id": "niBand4",
      "type": "VALUE",
      "expr": "#pos(#min(#niPay, #table.lookup('niLimits', #frequency, 'FUST')) - #table.lookup('niLimits', #frequency, 'PT'))"
    },
    {
      "id": "niBand5",
      "type": "VALUE",
      "expr": "#pos(#min(#niPay, #table.lookup('niLimits', #frequency, 'UEL')) - #table.lookup('niLimits', #frequency, 'FUST'))"
    },
    {
      "id": "niBand6",
      "type": "VALUE",
      "expr": "#pos(#niPay - #table.lookup('niLimits', #frequency, 'UEL'))"
    },
    {
      "id": "nationalInsurance",
      "type": "CONTRIBUTION",
      "label": "National Insurance (Class 1)",
      "ledger": "SOCIAL_SECURITY",
      "source": "hmrc-ni-guidance-2026",
      "when": "#niPay > #table.lookup('niLimits', #frequency, 'ST')",
      "base": "#niPay",
      "employee": {
        "amount": "#round(#round((#niBand4 + #niBand5) * #table.lookup('niEmployeeRates', #employee['niCategory'], 'E'), 3, 'DOWN'), 2, 'HALF_DOWN') + #round(#round(#niBand6 * #table.lookup('niEmployeeRates', #employee['niCategory'], 'F'), 3, 'DOWN'), 2, 'HALF_DOWN')"
      },
      "employer": {
        "amount": "#round(#round((#niBand2 + #niBand3 + #niBand4) * #table.lookup('niEmployerRates', #employee['niCategory'], 'D') + #niBand5 * #table.lookup('niEmployerRates', #employee['niCategory'], 'E'), 3, 'DOWN'), 2, 'HALF_DOWN') + #round(#round(#niBand6 * #table.lookup('niEmployerRates', #employee['niCategory'], 'F'), 3, 'DOWN'), 2, 'HALF_DOWN')"
      }
    }
  ],
  "limitations": [
    "Weekly, two-weekly and monthly pay. A payday in tax week 53 (week 54 for two-weekly pay) is worked out with the week 1 (week 2) table on a non-cumulative basis, and a suffix code pays no PAYE there when the free pay to date at week 52 covers the year's pay (CWG2 1.13, specification para 14); NICs follow the normal earnings period.",
    "Directors (annual NIC earnings period), student and postgraduate loans, and pre-tax deductions (net pay pensions, salary sacrifice) are refused.",
    "Mid-year starts and adoptions need the pay and tax brought forward for the tax year (P45 and/or previous payroll) on a cumulative code.",
    "Payrolled benefits in kind are not included; the regulatory limit is applied to the whole pay for the period.",
