<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
    objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- When the admin was emailed that the workspace is about to be deleted; it is never deleted before -->
    <changeSet id="20261028-add-deletion-warning-to-tenant" author="halimzaaim">
        <addColumn tableName="tenant">
            <column name="deletion_warning_sent_at" type="${datetimeType}"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="tenant" columnName="deletion_warning_sent_at"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
